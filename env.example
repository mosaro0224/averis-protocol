# Averis Protocol V2 — API Server + Deploy Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.

# ── Chain ─────────────────────────────────────────────────────────────────────
ARC_CHAIN_ID=1227
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_EXPLORER=https://explorer.testnet.arc.io

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── Contract Addresses (Arc Testnet) — update after each redeploy ─────────────
# Query GET /v1/discover for live addresses after deployment.
AVERIS_VAULT=
AVERIS_ACP=
AVERIS_ROUTER=
AVERIS_REGISTRY=
AVERIS_CREDIT=
AVERIS_HOOD=
AVERIS_FACTORY=
AVERIS_FINANCING=
AVERIS_ACP_ADAPTER=
AVERIS_RESERVE=

# ── USDC (Arc Testnet native — same address on all Arc environments) ──────────
AVERIS_USDC=0x3600000000000000000000000000000000000000

# ── API Public URL (update after deploying frontend) ─────────────────────────
API_BASE_URL=https://api.averisprotocol.xyz

# ── Deploy script params (used by script/DeployV2.s.sol) ─────────────────────
# PROTOCOL_OWNER: wallet that will own all contracts (deployer wallet)
PROTOCOL_OWNER=0x4bAf1e5E3355f37539f423Ba251Dd7f98fE2Ea56
TREASURY_ADDRESS=0x4bAf1e5E3355f37539f423Ba251Dd7f98fE2Ea56
ARC_USDC=0x3600000000000000000000000000000000000000

# Hood limits (in USDC with 6 decimals — e.g. 10000000000 = 10,000 USDC)
HOOD_MAX_PER_AGENT_USDC=10000000000
HOOD_MAX_TOTAL_USDC=50000000000
HOOD_TIER_CAP_NATIVE_USDC=10000000000
HOOD_TIER_CAP_VERIFIED_USDC=5000000000
HOOD_TIER_CAP_ATTESTED_USDC=1000000000
HOOD_MAX_JOBS_PER_AGENT=5
HOOD_MAX_CONCENTRATION_BPS=5000

# Financing params
ADVANCE_RATE_BPS=4000
FEE_BPS=200
PROTOCOL_MAX_USDC=50000000000
PER_TX_LIMIT_USDC=10000000000
